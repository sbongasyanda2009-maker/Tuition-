/* =========================================================
   PHYSIMATHS TUITION CENTRE
   PREMIUM WEBSITE STYLESHEET
========================================================= */

/* ---------- RESET ---------- */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "DM Sans", sans-serif;
    color: #182334;
    background: #f8fafc;
    line-height: 1.6;
}

img {
    max-width: 100%;
    display: block;
}

a {
    text-decoration: none;
}

button,
input,
select,
textarea {
    font: inherit;
}


/* ---------- VARIABLES ---------- */

:root {
    --navy: #07111f;
    --navy-light: #0d1a2c;
    --navy-card: #15253a;

    --gold: #d6a84f;
    --gold-dark: #a57a2e;
    --gold-soft: #f0e5cc;

    --white: #ffffff;
    --off-white: #f8fafc;

    --text: #182334;
    --muted: #667588;
    --light-muted: #9eacbd;

    --border: #dce4ec;

    --shadow:
        0 20px 50px rgba(7, 17, 31, 0.10);

    --radius: 20px;
}


/* ---------- GLOBAL CONTAINER ---------- */

.container {
    width: min(1160px, 92%);
    margin: 0 auto;
}


/* ---------- HEADER ---------- */

.site-header {
    position: sticky;
    top: 0;
    z-index: 1000;

    background: rgba(7, 17, 31, 0.94);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.nav {
    min-height: 76px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    position: relative;
}


/* ---------- BRAND ---------- */

.brand {
    display: flex;
    align-items: center;
    gap: 10px;

    color: var(--white);
}

.brand-mark {
    width: 40px;
    height: 40px;

    display: grid;
    place-items: center;

    border-radius: 11px;

    background: var(--gold);
    color: var(--navy);

    font-family: "Manrope", sans-serif;
    font-weight: 800;

    box-shadow:
        0 8px 20px rgba(214, 168, 79, 0.25);
}

.brand-text strong {
    display: block;

    font-family: "Manrope", sans-serif;

    font-size: 16px;
    line-height: 1.1;
}

.brand-text small {
    display: block;

    margin-top: 3px;

    font-size: 10px;

    letter-spacing: 0.14em;

    text-transform: uppercase;

    opacity: 0.62;
}


/* ---------- NAVIGATION ---------- */

.nav-links {
    display: flex;
    align-items: center;
    gap: 25px;
}

.nav-links a {
    color: #dce5f1;

    font-size: 14px;
    font-weight: 500;

    transition:
        color 0.2s ease,
        transform 0.2s ease;
}

.nav-links a:hover {
    color: var(--white);
}

.nav-cta {
    padding: 10px 17px;

    border-radius: 9px;

    background: var(--gold);

    color: var(--navy) !important;

    font-weight: 700 !important;

    box-shadow:
        0 8px 22px rgba(214, 168, 79, 0.18);
}

.nav-cta:hover {
    transform: translateY(-1px);
}


/* ---------- MOBILE MENU BUTTON ---------- */

.menu-toggle {
    display: none;

    padding: 9px 13px;

    border: 1px solid rgba(255, 255, 255, 0.18);

    border-radius: 9px;

    background: transparent;

    color: white;

    cursor: pointer;
}


/* =========================================================
   HERO
========================================================= */

.hero {
    position: relative;

    overflow: hidden;

    padding:
        96px 0
        82px;

    background: var(--navy);

    color: white;
}

.hero::before {
    content: "";

    position: absolute;

    width: 500px;
    height: 500px;

    left: -250px;
    bottom: -300px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(214, 168, 79, 0.13),
            transparent 70%
        );
}

.hero-glow {
    position: absolute;

    width: 650px;
    height: 650px;

    right: -260px;
    top: -250px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(214, 168, 79, 0.16),
            transparent 65%
        );

    pointer-events: none;
}


/* ---------- HERO GRID ---------- */

.hero-grid {
    display: grid;

    grid-template-columns:
        1.05fr
        0.8fr;

    gap: 70px;

    align-items: center;

    position: relative;

    z-index: 1;
}


/* ---------- EYEBROW ---------- */

.eyebrow {
    margin-bottom: 13px;

    color: var(--gold);

    font-size: 12px;

    font-weight: 800;

    letter-spacing: 0.16em;

    text-transform: uppercase;
}


/* ---------- HERO TITLE ---------- */

.hero h1 {
    max-width: 750px;

    margin-bottom: 24px;

    font-family: "Manrope", sans-serif;

    font-size:
        clamp(
            43px,
            6vw,
            70px
        );

    line-height: 1.04;

    letter-spacing: -0.045em;
}

.hero h1 span {
    color: var(--gold);
}


/* ---------- HERO DESCRIPTION ---------- */

.hero-text {
    max-width: 650px;

    color: #b9c6d6;

    font-size: 18px;

    line-height: 1.7;
}


/* ---------- HERO BUTTONS ---------- */

.hero-actions {
    display: flex;

    gap: 13px;

    margin:
        30px
        0
        42px;

    flex-wrap: wrap;
}


/* ---------- BUTTONS ---------- */

.btn {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 10px;

    min-height: 48px;

    padding:
        13px
        20px;

    border-radius: 10px;

    border: 1px solid transparent;

    font-weight: 700;

    cursor: pointer;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
}

.btn:hover {
    transform: translateY(-2px);
}

.btn-primary {
    background: var(--gold);

    color: var(--navy);

    box-shadow:
        0 10px 28px
        rgba(214, 168, 79, 0.22);
}

.btn-primary:hover {
    box-shadow:
        0 15px 32px
        rgba(214, 168, 79, 0.30);
}

.btn-ghost {
    border-color:
        rgba(255, 255, 255, 0.20);

    color: white;

    background:
        rgba(255, 255, 255, 0.02);
}

.btn-dark {
    background: var(--navy);

    color: white;
}

.full {
    width: 100%;
}


/* ---------- HERO TRUST ---------- */

.trust-row {
    display: flex;

    gap: 32px;

    flex-wrap: wrap;
}

.trust-row div {
    display: grid;
}

.trust-row strong {
    font-family: "Manrope", sans-serif;

    font-size: 20px;
}

.trust-row span {
    max-width: 120px;

    color: #8392a5;

    font-size: 11px;

    line-height: 1.4;
}


/* =========================================================
   HERO CARD
========================================================= */

.hero-card {
    padding: 32px;

    border:
        1px solid
        rgba(255, 255, 255, 0.10);

    border-radius: 24px;

    background:
        linear-gradient(
            145deg,
            #15253a,
            #0d1a2c
        );

    box-shadow:
        0 30px 80px
        rgba(0, 0, 0, 0.35);
}

.card-kicker,
.card-label {
    color: var(--gold);

    font-size: 11px;

    font-weight: 800;

    letter-spacing: 0.15em;
}

.hero-card h2 {
    margin:
        9px
        0
        25px;

    font-family: "Manrope", sans-serif;

    font-size: 31px;

    line-height: 1.12;
}

.method-list > div {
    display: grid;

    grid-template-columns:
        38px
        1fr;

    gap: 13px;

    padding: 17px 0;

    border-top:
        1px solid
        rgba(255, 255, 255, 0.08);
}

.method-list span {
    color: var(--gold);

    font-size: 12px;

    font-weight: 800;
}

.method-list p {
    margin: 0;

    color: #aebbc9;

    font-size: 13px;
}

.method-list strong {
    color: white;
}

.text-link {
    display: inline-block;

    margin-top: 8px;

    color: var(--gold);

    font-size: 13px;

    font-weight: 700;
}


/* =========================================================
   PROOF STRIP
========================================================= */

.proof-strip {
    background: #eaf0f5;

    border-bottom:
        1px solid
        var(--border);
}

.proof-grid {
    min-height: 72px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;
}

.proof-grid p {
    margin: 0;

    color: #506073;

    font-size: 12px;

    text-align: center;
}

.proof-grid span {
    width: 1px;

    height: 20px;

    background: #cdd7e2;
}


/* =========================================================
   GENERAL SECTIONS
========================================================= */

.section {
    padding: 100px 0;
}

.section-heading {
    max-width: 720px;

    margin-bottom: 48px;
}

.section-heading h2,
.split h2,
.about h2,
.contact-section h2 {
    margin-bottom: 14px;

    color: #122033;

    font-family: "Manrope", sans-serif;

    font-size:
        clamp(
            32px,
            4vw,
            48px
        );

    line-height: 1.1;

    letter-spacing: -0.035em;
}

.section-heading > p:last-child {
    color: var(--muted);
}


/* =========================================================
   SUBJECT CARDS
========================================================= */

.subject-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px;
}

.subject-card {
    padding: 30px;

    border:
        1px solid
        #e0e7ef;

    border-radius: var(--radius);

    background: white;

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

.subject-card:hover {
    transform: translateY(-6px);

    box-shadow:
        var(--shadow);
}

.subject-card.featured {
    border-color:
        var(--gold);
}

.icon {
    width: 48px;
    height: 48px;

    display: grid;
    place-items: center;

    margin-bottom: 20px;

    border-radius: 14px;

    background: var(--gold-soft);

    color: #7b5a20;

    font-size: 23px;

    font-weight: 800;
}

.subject-card h3 {
    margin:
        5px
        0
        10px;

    font-family: "Manrope", sans-serif;

    font-size: 25px;
}

.subject-card > p:not(.card-label) {
    color: var(--muted);

    font-size: 14px;
}

.subject-card ul {
    display: grid;

    gap: 8px;

    margin-top: 20px;

    padding: 0;

    list-style: none;
}

.subject-card li {
    font-size: 13px;

    font-weight: 600;
}

.subject-card li::before {
    content: "✓";

    margin-right: 8px;

    color: var(--gold-dark);
}


/* =========================================================
   DARK SECTION
========================================================= */

.dark-section {
    padding: 100px 0;

    background: var(--navy);

    color: white;
}

.section-heading.light h2 {
    color: white;
}

.section-heading.light > p:last-child {
    color: #9eacbd;
}


/* =========================================================
   PROGRAMMES
========================================================= */

.programme-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 16px;
}

.programme {
    min-height: 245px;

    padding: 28px;

    border:
        1px solid
        rgba(255, 255, 255, 0.09);

    border-radius: 18px;

    background:
        rgba(255, 255, 255, 0.015);

    transition:
        transform 0.25s ease,
        background 0.25s ease;
}

.programme:hover {
    transform: translateY(-5px);

    background:
        rgba(255, 255, 255, 0.035);
}

.programme .number {
    color: var(--gold);

    font-size: 12px;

    font-weight: 800;
}

.programme h3 {
    margin:
        17px
        0
        10px;

    font-family: "Manrope", sans-serif;

    font-size: 23px;
}

.programme p {
    color: #aab7c7;

    font-size: 14px;
}

.programme a {
    display: inline-block;

    margin-top: 20px;

    color: var(--gold);

    font-size: 13px;

    font-weight: 700;
}


/* =========================================================
   PRICING
========================================================= */

.pricing {
    display: grid;

    grid-template-columns:
        0.8fr
        1.2fr;

    gap: 45px;

    margin-top: 55px;

    padding: 35px;

    border:
        1px solid
        rgba(255, 255, 255, 0.09);

    border-radius: 22px;

    background: #101f33;
}

.pricing h2 {
    margin-bottom: 15px;

    font-family: "Manrope", sans-serif;

    font-size: 30px;

    line-height: 1.15;
}

.pricing p {
    color: #aab7c7;

    font-size: 14px;
}

.price-table-wrap {
    overflow-x: auto;
}

table {
    width: 100%;

    min-width: 510px;

    border-collapse: collapse;
}

th,
td {
    padding: 14px 12px;

    border-bottom:
        1px solid
        rgba(255, 255, 255, 0.08);

    text-align: left;

    font-size: 13px;
}

th {
    color: var(--gold);

    font-size: 11px;

    letter-spacing: 0.08em;

    text-transform: uppercase;
}

td {
    color: #d7dee7;
}

.fine-print {
    margin-top: 15px;

    font-size: 11px !important;

    line-height: 1.6;
}


/* =========================================================
   LEARNING SYSTEM
========================================================= */

.split {
    display: grid;

    grid-template-columns:
        0.8fr
        1.2fr;

    gap: 80px;
}

.lead {
    color: var(--muted);

    font-size: 16px;
}

.steps {
    display: grid;

    gap: 12px;
}

.steps article {
    display: grid;

    grid-template-columns:
        45px
        1fr;

    gap: 16px;

    padding:
        21px
        0;

    border-top:
        1px solid
        #dde5ed;
}

.steps span {
    color: var(--gold-dark);

    font-weight: 800;
}

.steps h3 {
    margin-bottom: 5px;

    font-family: "Manrope", sans-serif;

    font-size: 18px;
}

.steps p {
    color: var(--muted);

    font-size: 14px;
}


/* =========================================================
   QUOTE SECTION
========================================================= */

.quote-section {
    padding: 75px 0;

    background: #e9eef3;

    text-align: center;
}

.quote {
    max-width: 800px;
}

.quote-mark {
    color: var(--gold);

    font-family: Georgia, serif;

    font-size: 80px;

    line-height: 0.4;
}

.quote blockquote {
    margin:
        25px
        0
        10px;

    font-family: "Manrope", sans-serif;

    font-size:
        clamp(
            25px,
            4vw,
            40px
        );

    line-height: 1.2;
}

.quote > p:last-child {
    color: #6a7889;
}


/* =========================================================
   ABOUT
========================================================= */

.about {
    background: white;
}

.about-grid {
    display: grid;

    grid-template-columns:
        0.8fr
        1.2fr;

    gap: 80px;

    align-items: center;
}

.about-photo {
    width: 100%;

    aspect-ratio: 1 / 1;

    display: grid;

    place-items: center;

    overflow: hidden;

    border-radius: 24px;

    background:
        linear-gradient(
            145deg,
            #dce4ec,
            #aebdcb
        );

    color: #536376;

    text-align: center;
}

.about-photo span {
    font-family: "Manrope", sans-serif;

    font-size: 75px;

    font-weight: 800;
}

.about-photo p {
    font-size: 12px;
}

.about-points {
    margin:
        28px
        0;
}

.about-points p {
    padding: 13px 0;

    border-top:
        1px solid
        #e0e6ec;

    font-weight: 600;
}

.about-points strong {
    margin-right: 12px;

    color: var(--gold-dark);
}


/* =========================================================
   FAQ
========================================================= */

.narrow {
    max-width: 850px;
}

.faq {
    border-top:
        1px solid
        var(--border);
}

.faq details {
    padding: 20px 0;

    border-bottom:
        1px solid
        var(--border);
}

.faq summary {
    cursor: pointer;

    font-family: "Manrope", sans-serif;

    font-weight: 700;

    list-style-position: outside;
}

.faq p {
    margin-top: 14px;

    color: var(--muted);

    font-size: 14px;
}


/* =========================================================
   CONTACT
========================================================= */

.contact-section {
    padding: 100px 0;

    background: var(--navy);

    color: white;
}

.contact-section h2 {
    color: white;
}

.contact-section > .container > div > p:not(.eyebrow) {
    color: #aebaca;
}

.contact-grid {
    display: grid;

    grid-template-columns:
        0.85fr
        1.15fr;

    gap: 80px;

    align-items: start;
}


/* ---------- CONTACT DETAILS ---------- */

.contact-details {
    display: grid;

    gap: 14px;

    margin-top: 35px;
}

.contact-details a,
.contact-details div {
    display: grid;

    padding: 15px 0;

    border-top:
        1px solid
        rgba(255, 255, 255, 0.09);

    color: white;
}

.contact-details span {
    color: var(--gold);

    font-size: 11px;

    letter-spacing: 0.12em;

    text-transform: uppercase;
}

.contact-details strong {
    font-size: 15px;
}


/* =========================================================
   ENQUIRY FORM
========================================================= */

.enquiry-form {
    display: grid;

    gap: 15px;

    padding: 28px;

    border-radius: 22px;

    background: white;

    color: var(--text);

    box-shadow:
        0 30px 70px
        rgba(0, 0, 0, 0.25);
}

.enquiry-form label {
    color: #344255;

    font-size: 12px;

    font-weight: 700;
}

.enquiry-form input,
.enquiry-form select,
.enquiry-form textarea {
    display: block;

    width: 100%;

    margin-top: 6px;

    padding: 12px;

    border:
        1px solid
        #d9e1e9;

    border-radius: 9px;

    outline: none;

    background: #fbfcfd;

    color: var(--text);

    font-size: 14px;

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.enquiry-form input:focus,
.enquiry-form select:focus,
.enquiry-form textarea:focus {
    border-color: var(--gold);

    box-shadow:
        0 0 0 3px
        rgba(214, 168, 79, 0.14);
}

.enquiry-form textarea {
    resize: vertical;

    min-height: 110px;
}

.form-row {
    display: grid;

    grid-template-columns:
        1fr
        1fr;

    gap: 13px;
}

.form-note,
.form-status {
    margin: 0;

    color: #758395;

    font-size: 11px;
}

.form-status {
    min-height: 16px;
}


/* =========================================================
   FOOTER
========================================================= */

footer {
    padding:
        45px
        0
        20px;

    background: #050c15;

    color: #8290a1;
}

.footer-grid {
    display: grid;

    grid-template-columns:
        1.4fr
        1fr
        1fr;

    gap: 30px;

    padding-bottom: 30px;
}

.footer-grid p {
    font-size: 12px;
}

.footer-grid a {
    color: #aeb9c7;
}

.footer-grid .brand {
    margin-bottom: 12px;
}

.copyright {
    padding-top: 18px;

    border-top:
        1px solid
        rgba(255, 255, 255, 0.07);

    font-size: 11px;
}

.copyright span {
    color: var(--gold);
}


/* =========================================================
   ACCESSIBILITY
========================================================= */

a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
summary:focus-visible {
    outline:
        3px solid
        rgba(214, 168, 79, 0.55);

    outline-offset: 3px;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 950px) {

    .nav-links {
        gap: 15px;
    }

    .nav-links a {
        font-size: 13px;
    }

    .hero-grid {
        gap: 45px;
    }

    .subject-grid,
    .programme-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .split {
        gap: 45px;
    }

    .about-grid {
        gap: 45px;
    }

    .contact-grid {
        gap: 45px;
    }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 800px) {

    .site-header {
        position: sticky;
    }

    .menu-toggle {
        display: block;
    }

    .nav-links {
        display: none;

        position: absolute;

        left: 0;
        right: 0;

        top: 70px;

        flex-direction: column;

        align-items: stretch;

        gap: 3px;

        padding: 14px;

        border:
            1px solid
            rgba(255, 255, 255, 0.08);

        border-radius: 14px;

        background: #0d1a2c;

        box-shadow:
            0 20px 45px
            rgba(0, 0, 0, 0.25);
    }

    .nav-links.open {
        display: flex;
    }

    .nav-links a {
        padding: 11px;
    }

    .nav-cta {
        text-align: center;
    }


    .hero {
        padding:
            70px
            0
            65px;
    }

    .hero-grid {
        grid-template-columns: 1fr;

        gap: 45px;
    }

    .hero-card-wrap {
        max-width: 650px;
    }


    .proof-grid {
        min-height: auto;

        padding:
            17px
            0;

        flex-wrap: wrap;

        justify-content: center;
    }

    .proof-grid span {
        display: none;
    }


    .section,
    .dark-section,
    .contact-section {
        padding:
            70px
            0;
    }


    .subject-grid,
    .programme-grid {
        grid-template-columns: 1fr;
    }


    .pricing {
        grid-template-columns: 1fr;

        gap: 30px;

        padding: 25px;
    }


    .split,
    .about-grid,
    .contact-grid {
        grid-template-columns: 1fr;
    }


    .about-photo {
        max-width: 500px;
    }


    .contact-grid {
        gap: 45px;
    }


    .footer-grid {
        grid-template-columns: 1fr;
    }
}


